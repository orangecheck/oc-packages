{
  "name": "@orangecheck/app-design",
  "version": "1.11.0",
  "description": "The ochk.app design system: tokens, type, the isometric check, halftone photography, primitives and app chrome. Its own system, scoped under data-oc-app=\"ochk\" so it never reaches the .ochk.io family sites.",
  "keywords": [
    "orangecheck",
    "ochk.app",
    "design-system",
    "tokens",
    "react",
    "internal"
  ],
  "author": "OrangeCheck",
  "license": "MIT",
  "homepage": "https://design.ochk.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/orangecheck/oc-packages.git",
    "directory": "app-design"
  },
  "bugs": {
    "url": "https://github.com/orangecheck/oc-packages/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.mjs",
      "require": "./dist/primitives.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.mjs",
      "require": "./dist/brand.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.js"
    },
    "./chrome": {
      "types": "./dist/chrome.d.ts",
      "import": "./dist/chrome.mjs",
      "require": "./dist/chrome.js"
    },
    "./family": {
      "types": "./dist/family.d.ts",
      "import": "./dist/family.mjs",
      "require": "./dist/family.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.mjs",
      "require": "./dist/code.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.mjs",
      "require": "./dist/format.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "import": "./dist/mdx.mjs",
      "require": "./dist/mdx.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.mjs",
      "require": "./dist/session.js"
    },
    "./acknowledgement": {
      "types": "./dist/acknowledgement.d.ts",
      "import": "./dist/acknowledgement.mjs",
      "require": "./dist/acknowledgement.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.mjs",
      "require": "./dist/vitest.js"
    },
    "./og": {
      "types": "./dist/og.d.ts",
      "import": "./dist/og.mjs",
      "require": "./dist/og.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/gen-palette.mjs && tsup && yarn copy:css",
    "copy:css": "rm -rf dist/styles && mkdir -p dist/styles && cp src/styles.css dist/styles.css && cp -R src/styles/. dist/styles/",
    "test": "node scripts/check-contrast.mjs && node scripts/check-swagger.mjs && node scripts/check-og.mjs && node scripts/check-isolation.mjs && node scripts/check-shell.mjs && node scripts/check-mirror.mjs && node scripts/check-code.mjs && node scripts/check-entries.mjs && node scripts/check-render.mjs && node scripts/check-dom.mjs && node scripts/check-layout.mjs && node scripts/check-next.mjs",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@orangecheck/auth-client": "^2.32.0",
    "lucide-react": ">=0.400.0",
    "next": "^15.0.0 || ^16.0.0",
    "next-themes": "^0.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@orangecheck/auth-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orangecheck/auth-client": "^2.32.3",
    "@orangecheck/auth-core": "^2.5.0",
    "@orangecheck/wallet-adapter": "^0.6.4",
    "@tailwindcss/cli": "^4.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.2",
    "lucide-react": "^0.544.0",
    "mermaid": "^11.14.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "playwright-core": "~1.60.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
