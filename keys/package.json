{
  "name": "@orangecheck/keys",
  "version": "0.0.0",
  "private": true,
  "description": "Reference implementation of orangecheck account keys: two secrets per account, the passkey PRF lock, and the binding, takeover and retire records with their custody rule. Unreleased.",
  "keywords": [
    "bitcoin",
    "bip322",
    "bip39",
    "passkey",
    "prf",
    "orangecheck"
  ],
  "author": "OrangeCheck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orangecheck/oc-packages.git",
    "directory": "keys"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "test-vectors",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "vectors": "OC_KEYS_WRITE_VECTORS=1 vitest run test/vectors.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@orangecheck/auth-core": "^2.35.0",
    "@orangecheck/bip322": "^1.2.0",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
