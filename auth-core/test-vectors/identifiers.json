            "DID:OC:0123456789abcdef0123456789abcdef",
            "Did:oc:0123456789abcdef0123456789abcdef",
            " did:oc:0123456789abcdef0123456789abcdef",
            "did:oc:0123456789abcdef0123456789abcdef ",
            "did:oc:0123456789abcdef0123456789abcdef\n",
            "did:oc:0123456789abcdef0123456789abcdef\r\n",
