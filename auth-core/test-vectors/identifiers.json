            "xdid:oc:0123456789abcdef0123456789abcdef",
            "did:oc:0123456789abcdef0123456789abcdef:x",
            "did:oc:0123456789abcdef0123456789abcdeg",
            "did:oc:0123456789abcdef0123456789abcde\u0661",
            "did:oc:\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10",
